# Server only. Use a pooled or direct PostgreSQL connection accepted by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/climbing_tracker?schema=public"

# Safe public Supabase project identifiers (never use the service-role key here).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-or-anon-key"
# Public web origin used in Supabase email redirect URLs (no trailing slash).
NEXT_PUBLIC_WEB_ORIGIN="http://localhost:3000"
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-publishable-or-anon-key"
# Web origin that receives mobile confirmation/recovery links (no trailing slash).
EXPO_PUBLIC_WEB_URL="http://localhost:3000"

# URL Expo uses to reach the Next.js API (use the computer's LAN IP on a device).
EXPO_PUBLIC_API_URL="http://localhost:3000"
